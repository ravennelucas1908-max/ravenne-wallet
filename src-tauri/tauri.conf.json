{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ravenne Wallet",
  "version": "7.0.0",
  "identifier": "io.ravenne.wallet",
  "build": {
    "beforeDevCommand": "npm run ui:bundle",
    "beforeBuildCommand": "npm run ui:bundle",
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ravenne Wallet",
        "width": 1080,
        "height": 700,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2NjQ2QjMwNzZCRDQ1M0IKUldRN1JiMTJNR3RrWm9XZlBia3VZcHB3S0FobkdCeStoYndFb1huTWZHdnVJYUlPTjdvWDFQbGUK",
      "endpoints": [
        "https://github.com/ravennelucas1908-max/ravenne-wallet/releases/latest/download/latest.json"
      ]
    }
  }
}